# Copy to .env and fill in the value. .env is gitignored — never commit a real
# key, never inline one in source, never put one in a test fixture.
#
# The SDK reads this variable directly (typesafe_sdk.constants.API_KEY_ENV) and
# sends it as an Authorization: Bearer header. Get the value from the TypeSafe
# console; there is no client-side format check, so a typo surfaces as a 401.
TYPESAFE_API_KEY=

# Optional. Leave unset to use the SDK default (https://api.typesafe.ai).
# TYPESAFE_BASE_URL=
