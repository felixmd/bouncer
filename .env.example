# Copy to .env and fill in the value. .env is gitignored — never commit a real
# key, never inline one in source, never put one in a test fixture.
#
# The SDK reads this variable directly (typesafe_sdk.constants.API_KEY_ENV) and
# sends it as an Authorization: Bearer header. Get the value from the TypeSafe
# console; there is no client-side format check, so a typo surfaces as a 401.
TYPESAFE_API_KEY=

# Optional. Leave unset to use the SDK default (https://api.typesafe.ai).
# TYPESAFE_BASE_URL=


# --- Reddit, dev-time only -------------------------------------------------
# Only feed/reddit_fetch.py reads these. The demo itself never calls Reddit.
#
# Needed because Reddit now serves 403 to unauthenticated .json endpoints from
# many networks, including this one — it is an IP block, not a User-Agent
# problem. Create a *script* app at https://www.reddit.com/prefs/apps: the
# client id is the string under the app name, the secret is the "secret" field.
# Leave both blank if your network can still reach the public endpoint.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
